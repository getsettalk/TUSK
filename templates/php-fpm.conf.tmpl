; Chowk-managed php-fpm config. Regenerated on start.
[global]
pid = {{CHOWK}}/run/php-fpm.pid
error_log = {{CHOWK}}/logs/php-fpm.log
daemonize = yes

[www]
user = {{USER}}
group = {{GROUP}}
listen = {{CHOWK}}/run/php.sock
listen.owner = {{USER}}
listen.group = {{GROUP}}
listen.mode = 0660

pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500

php_admin_value[error_log] = {{CHOWK}}/logs/php-errors.log
php_admin_flag[log_errors] = on
