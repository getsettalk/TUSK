# Chowk-managed nginx config. Do not edit by hand — regenerated on start.
worker_processes  auto;
pid               {{CHOWK}}/run/nginx.pid;
error_log         {{CHOWK}}/logs/nginx-error.log;

events {
    worker_connections  1024;
}

http {
    include       {{BREW}}/etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile           on;
    keepalive_timeout  65;
    client_max_body_size 128M;

    access_log  {{CHOWK}}/logs/nginx-access.log;

    # Per-site vhosts generated by `chowk site add`
    include {{CHOWK}}/sites/*.conf;

    # Fallback so http://localhost always answers
    server {
        listen 80 default_server;
        server_name localhost;
        root {{CHOWK}}/apps/dashboard;
        index index.html index.php;
        location / { try_files $uri $uri/ =404; }
    }
}
