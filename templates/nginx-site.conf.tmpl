# Chowk site: {{SERVER_NAME}}  (generated — edit via `chowk site` commands)
server {
    listen 80;
    server_name {{SERVER_NAME}};
    root {{DOCROOT}};
    index index.php index.html index.htm;

    access_log {{CHOWK}}/logs/{{NAME}}-access.log;
    error_log  {{CHOWK}}/logs/{{NAME}}-error.log;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:{{CHOWK}}/run/php.sock;
        fastcgi_index index.php;
        include {{BREW}}/etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
