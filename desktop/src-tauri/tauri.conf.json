{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tusk",
  "version": "0.1.8",
  "identifier": "com.getsettalk.tusk",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tusk",
        "width": 440,
        "height": 600,
        "minWidth": 380,
        "minHeight": 500,
        "maxWidth": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Free local dev environment",
    "longDescription": "PHP (multi-version) + MariaDB + Nginx/Apache + phpMyAdmin, managed from one app."
  }
}
